library(tidyverse)
bd <- readxl::read_xls("/home/sadraque/Documentos/UFS/Disciplinas/2025.1/Probabilidade1/avaliações/Avaliação1/notas/notas_ESTAT0072_T02_20251.xls",
skip = 9)
presenca <- bd |>
mutate(unid1 = ifelse(`Unid. 1`== 0, 0, 1)) |>
select(unid1) |>
table()
presenca
notas <- bd |>
select(prova1 = `Unid. 1`) |>
drop_na(prova1) |>
filter(prova1 != 0)
notas
40/42
estatisticas <- notas %>%
summarise(min = min(prova1),
media = mean(prova1),
mediana = median(prova1),
max = max(prova1),
desvpad = sd(prova1),
coefvar = mean(prova1)/sd(prova1))
